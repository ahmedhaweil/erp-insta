# Application
APP_PORT=3000
APP_ENV=development
APP_NAME=erp-saas

# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=erp_saas
DB_USER=erp_admin
DB_PASSWORD=erp_secret
DB_SSL=false
DB_LOGGING=true

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRY=15m
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-in-production
JWT_REFRESH_EXPIRY=7d

# File Storage (S3/R2)
S3_BUCKET=erp-files
S3_ENDPOINT=http://localhost:9000
S3_REGION=auto
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin

# Elasticsearch
ELASTICSEARCH_URL=http://localhost:9200

# ZATCA (Saudi e-invoicing)
ZATCA_ENV=sandbox
ZATCA_CERT_PATH=
ZATCA_PRIVATE_KEY_PATH=

# ETA (Egypt e-invoicing)
ETA_API_URL=https://api.invoicing.eta.gov.eg
ETA_CLIENT_ID=
ETA_CLIENT_SECRET=

# WhatsApp
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=

# Email
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@erp-platform.com

# Rate Limiting
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=100
